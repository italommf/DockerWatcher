[ssh]
# Configurações de SSH para acessar o cluster Kubernetes
host = 192.168.1.100
port = 22
username = seu_usuario
password = sua_senha

[mysql]
# Configurações do MySQL
# O Django usará o banco 'docker_watcher' para armazenar robôs
# O banco 'bwav4' (especificado abaixo) é usado para consultar execuções
host = 192.168.1.100
port = 3306
user = seu_usuario_mysql
password = sua_senha_mysql
database = bwav4

[execucoes_api]
# API para buscar execuções (MongoDB)
# Esta API substitui a busca direta no MySQL bwav4
base_url = http://192.168.27.252:19000
username = rpa@bwa.global
password = sua_senha_api
